{
  "name": "qa-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui-elements": "playwright test tests/ui-elements-practice",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "deploy:target": "npx --yes surge@0.23.1 targets/ui-elements-practice qa-playground-ui.surge.sh",
    "test:resume": "playwright test --project=resume-checks --project=resume-app",
    "test:resume:ai": "RESUME_AI=1 playwright test --project=resume-ai",
    "resume:serve": "node targets/resume-refactor/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "2.44.0",
    "allure-playwright": "^3.0.0",
    "typescript": "^5.9.2"
  }
}
